{
  "manifest_version": 3,
  "name": "Marginalia",
  "version": "0.1.0",
  "description": "Annotate web app UIs during a work session and export an offline end-of-day report.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "downloads",
    "offscreen",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "annotate": {
      "suggested_key": { "default": "Alt+Shift+N" },
      "description": "Toggle annotate mode"
    },
    "draw": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Toggle draw mode"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
